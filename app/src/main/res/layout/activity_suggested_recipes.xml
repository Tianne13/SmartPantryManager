<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".SuggestedRecipesActivity">

    <!-- Screen title -->
    <TextView
        android:id="@+id/tvRecipesTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Suggested Recipes"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- Small explanation under the title -->
    <TextView
        android:id="@+id/tvRecipesSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="Recipes you can make right now with what is in your pantry"
        android:textSize="14sp" />

    <!-- Message shown when no recipe matches the pantry -->
    <TextView
        android:id="@+id/tvNoRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:gravity="center"
        android:text="No recipes match your pantry yet - add more ingredients"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- The list of suggested recipes -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1" />

    <!-- the navigation bar from nav_bar.xml -->
    <include layout="@layout/nav_bar" />

</LinearLayout>